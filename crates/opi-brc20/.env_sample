DB_USER="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_DATABASE="postgres"
DB_PASSWD="*****"
DB_SSL="true"

NETWORK_TYPE="mainnet"
OPERATION_MODE="full"

## reporting system settings
REPORT_TO_INDEXER="true"
REPORT_URL="https://api.opi.network/report_block"
REPORT_RETRIES="10"
# set a name for report dashboard
REPORT_NAME="opi_brc20_index_rs"

# BRC20 programmable module settings (brc20-prog is required)
# The indexer calls admin methods (brc20_mine, brc20_finaliseBlock, ...).
# If brc20_prog sets BRC20_PROG_ADMIN_RPC_SERVER_URL, point this at that admin listener
# (e.g. http://127.0.0.1:18546), since the public listener rejects admin methods.
BRC20_PROG_RPC_URL="http://127.0.0.1:18545"
BRC20_PROG_RPC_USER="user"
BRC20_PROG_RPC_PASSWORD="password"

# Bitcoin RPC proxy for BRC20 programmable module
BITCOIN_RPC_PROXY_SERVER_ENABLED="true"
BITCOIN_RPC_PROXY_SERVER_ADDR="127.0.0.1:18547"
BITCOIN_RPC_URL="http://127.0.0.1:18332"
# If Bitcoin RPC should cache the responses (increases storage size)
# Light clients depend on this cache to avoid running a full node
BITCOIN_RPC_CACHE_ENABLED="true"