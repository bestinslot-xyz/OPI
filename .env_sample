# The one .env that `opi-indexer run` and `opi-indexer api` read. Copy it to .env
# in the repository root and fill it in. Both commands read the .env of their
# working directory (or an ancestor); `api` reads the file OPI_ENV_FILE names
# instead when that is set.

# ---- opi-indexer: source ----------------------------------------------------

# mainnet | signet | testnet4 | regtest. OPI_CHAIN and NETWORK_TYPE (shared by
# all modules) must name the same network.
OPI_CHAIN="signet"
NETWORK_TYPE="signet"

# ord's index database (redb) lives here.
OPI_ORD_DATA_DIR="/var/lib/opi/ord"
# The journal (journal.redb) that the modules read lives here.
OPI_JOURNAL_DIR="/var/lib/opi/journal"
# Blocks ord indexes per update while catching up.
OPI_CHUNK="1000"

# bitcoind RPC. The brc20 engine's Bitcoin lookups in full mode use the same
# URL and credentials, re-reading the cookie file on every request.
BITCOIN_RPC_URL="http://127.0.0.1:38332"
# Either user and password ...
BITCOIN_RPC_USER="user"
BITCOIN_RPC_PASSWD="password"
# ... or bitcoind's cookie file (leave USER and PASSWD unset).
# BITCOIN_RPC_COOKIE="/path/to/.cookie"

# Log filter (default: info).
# RUST_LOG="info"

# ---- metrics and health -----------------------------------------------------

# Each process serves GET /metrics (Prometheus), GET /health/live and
# GET /health/ready on a listener of its own, apart from the public API.
# Empty or unset runs no listener. Bind it to loopback or a private network.
# `opi-indexer run` and `opi-indexer brc20 light`:
# METRICS_ADDR="127.0.0.1:9100"
# `opi-indexer api`:
# API_METRICS_ADDR="127.0.0.1:9101"
# `run` and `brc20 light` are ready while no start-up fill runs and every
# enabled module is at most this many blocks behind the chain tip (bitcoind's
# best block; the OPI network's best verified block in light mode).
# READY_MAX_LAG_BLOCKS="2"
# ... and the chain tip was read at most this many seconds ago.
# READY_MAX_TIP_AGE_SECS="600"

# ---- modules ----------------------------------------------------------------

# Comma-separated modules to run, any subset of: brc20, bitmap, sns, runes.
# Each module keeps its own database. The API serves the same list.
OPI_MODULES="brc20"

# brc20 module database (OPI_MODULES includes brc20). The database name has no
# default and is required when the module is enabled; use brc20's own database,
# not postgres.
DB_USER="postgres"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_DATABASE="opi_brc20"
DB_PASSWD="*****"
DB_SSL="true"

# bitmap module database (OPI_MODULES includes bitmap). The database name has
# no default and is required when the module is enabled.
# BITMAP_DB_USER="postgres"
# BITMAP_DB_HOST="localhost"
# BITMAP_DB_PORT="5432"
# BITMAP_DB_DATABASE="opi_bitmap"
# BITMAP_DB_PASSWD=""
# BITMAP_DB_SSL="false"

# sns module database (OPI_MODULES includes sns). The database name has no
# default and is required when the module is enabled.
# SNS_DB_USER="postgres"
# SNS_DB_HOST="localhost"
# SNS_DB_PORT="5432"
# SNS_DB_DATABASE="opi_sns"
# SNS_DB_PASSWD=""
# SNS_DB_SSL="false"

# runes module database (OPI_MODULES includes runes). The database name has no
# default and is required when the module is enabled.
# RUNES_DB_USER="postgres"
# RUNES_DB_HOST="localhost"
# RUNES_DB_PORT="5432"
# RUNES_DB_DATABASE="opi_runes"
# RUNES_DB_PASSWD=""
# RUNES_DB_SSL="false"

# Block reports, shared by all modules. One REPORT_NAME names the node for
# every module; each report's payload carries its module type.
# REPORT_TO_INDEXER="true"
# REPORT_URL="https://api.opi.network/report_block"
# REPORT_NAME=""
# REPORT_RETRIES="10"

# ---- brc20 ------------------------------------------------------------------

# full (index with the journal source) | light (opi-indexer brc20 light).
# opi-indexer run needs full.
OPERATION_MODE="full"

# BRC20 programmable module settings. The brc20-prog engine runs inside the
# indexer process; `opi-indexer run` serves its public JSON-RPC (Blockscout,
# the swap sequencer and other clients connect there).
# Directory of the engine's database (required). An existing brc20-prog
# database works here once the standalone server is stopped.
BRC20_PROG_DB_PATH="/var/lib/opi/brc20-prog"
# Address of the public JSON-RPC server. It takes no credentials, so keep it
# on loopback or firewall it.
# BRC20_PROG_RPC_SERVER_URL="127.0.0.1:18545"
# The public JSON-RPC server runs when this is unset or exactly "true"; any
# other value turns it off.
# BRC20_PROG_RPC_SERVER_ENABLED="true"
# Transaction traces: on when unset or exactly "true". They make up the block
# trace hash OPI nodes compare and serve debug_traceTransaction. Fixed in the
# engine's database when it is created.
# EVM_RECORD_TRACES="true"
# The engine reads its other settings (EVM_CALL_GAS_LIMIT, request limits)
# from brc20-prog's own variables. brc20-prog's BRC20_PROG_RPC_SERVER_ENABLE_AUTH,
# _USER and _PASSWORD do not apply to the public server; ENABLE_AUTH=true
# without a user and password makes the engine fail to open. The Bitcoin RPC
# endpoint, network and chain id come from the Bitcoin settings and NETWORK_TYPE.

# The BRC20 programmable module reads Bitcoin data in process: from the Bitcoin
# RPC cache below and, in full mode, from bitcoind at BITCOIN_RPC_URL above
# (BITCOIN_RPC_USER/PASSWD or BITCOIN_RPC_COOKIE; full mode requires one).
# Light mode needs no bitcoind and no Bitcoin credentials.
# If Bitcoin RPC should cache the responses (increases storage size).
# Light clients depend on this cache to avoid running a full node: light mode
# requires true.
BITCOIN_RPC_CACHE_ENABLED="true"

# ---- API (opi-indexer api) --------------------------------------------------

# The API reads the module database settings above and only reads from them.
# Point it at a read-only database role through its own env file (OPI_ENV_FILE
# below) that sets DB_USER, BITMAP_DB_USER, ... to that role.
# Maximum connections per module database pool.
# DB_MAX_CONNECTIONS="10"
# One listener serves every module in OPI_MODULES.
# API_HOST="127.0.0.1"
# API_PORT="8000"
# Number of trusted proxies (for example nginx) in front of the API.
# API_TRUSTED_PROXY_CNT="0"
# Rate limiter: requests per window per client.
# RATE_LIMIT_ENABLE="false"
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX="100"
# How long a holders snapshot (/v1/brc20/ticker/holders/snapshot) may stream,
# in milliseconds; it holds a database connection meanwhile.
# API_SNAPSHOT_TIMEOUT_MS="600000"
# Alternative .env path for `opi-indexer api`. Works only as a process
# environment variable (it is read before the file is loaded), not inside a
# .env file.
# OPI_ENV_FILE="/path/to/.env"
